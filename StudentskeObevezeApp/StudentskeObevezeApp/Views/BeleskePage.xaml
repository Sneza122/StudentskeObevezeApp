<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentskeObevezeApp.Views.BeleskePage"
             Title="Beleške">

    <StackLayout Padding="10">

        <Editor x:Name="editorBeleška" 
                HeightRequest="200"
                Placeholder="Unesi svoju belešku ovde..." />

        <Button Text="Sačuvaj belešku" 
                Clicked="OnSacuvajClicked"
                Margin="0,10,0,0"/>

        <Label Text="Poslednja beleška:" FontAttributes="Bold" />
        <Label x:Name="labelPrikazBeleške" Text="(nema beleške)" />

    </StackLayout>
</ContentPage>
