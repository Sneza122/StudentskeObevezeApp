<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentskeObevezeApp.Views.BeleskePage"
             Title="Beleške"
             BackgroundColor="White">

    <StackLayout Padding="20" Spacing="15">

        <!-- Naslov -->
        <Label Text="Beleške"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="HotPink"
               HorizontalOptions="Center" />

        <!-- Prikaz svih beleški -->
        <CollectionView x:Name="beleškeList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10" BackgroundColor="#FFF0F5" Margin="0,5">
                        <Label Text="{Binding Tekst}" FontSize="16" TextColor="Black" />
                        <Label Text="{Binding Datum, StringFormat='{0:dd.MM.yyyy. HH:mm}'}"
                               FontSize="12"
                               TextColor="Gray" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Unos nove beleške -->
        <StackLayout x:Name="unosStack" IsVisible="False">
            <Editor x:Name="noviUnosEditor" Placeholder="Unesi novu belešku..." HeightRequest="100"/>
            <Button Text="Sačuvaj"
                    BackgroundColor="HotPink"
                    TextColor="White"
                    Clicked="OnSacuvajNovuClicked"/>
        </StackLayout>

        <!-- Dugme za dodavanje -->
        <Button x:Name="btnDodaj"
                Text="Dodaj belešku"
                BackgroundColor="HotPink"
                TextColor="White"
                Clicked="OnDodajClicked"/>

    </StackLayout>
</ContentPage>

