<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentskeObevezeApp.Views.IspitiPage"
             Title="Ispiti">

    <StackLayout Padding="20" Spacing="15">

        <Label Text="Ispiti"
               FontAttributes="Bold"
               FontSize="Large"
               TextColor="HotPink"
               HorizontalOptions="Center" />

        <CollectionView x:Name="ispitiListView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#fce4ec" Padding="10" CornerRadius="10" Margin="0,5">
                        <StackLayout>
                            <Label Text="{Binding Predmet}"
                                   FontAttributes="Bold"
                                   FontSize="Medium"
                                   TextColor="Black" />
                            <Label Text="{Binding DatumIspita, StringFormat='{0:dd.MM.yyyy. HH:mm}'}"
                                   FontSize="Small"
                                   TextColor="Gray" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button x:Name="btnDodajIspit"
                Text="Dodaj ispit"
                Clicked="OnDodajIspitClicked"
                BackgroundColor="HotPink"
                TextColor="White" />

        <StackLayout x:Name="addIspitForm" IsVisible="False">
            <Entry x:Name="entryPredmet" Placeholder="Unesi predmet" />
            <DatePicker x:Name="datePickerIspit" />
            <TimePicker x:Name="timePickerIspit" Time="09:00:00" />
            <Button Text="Sačuvaj"
                    Clicked="OnSaveIspitClicked"
                    BackgroundColor="HotPink"
                    TextColor="White" />
        </StackLayout>

    </StackLayout>
</ContentPage>
